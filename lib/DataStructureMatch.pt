include utils.incl

<xform GenDataMatchSpecification pars=(anchors, org_spec, impl_spec)>
  CODE.OpSpec#(org_in, org_out) = org_spec;
  GraphSpec#(org_nodes_out, org_nextto_out, org_reach_out, org_alias_out) = org_out;
  GraphSpec#(org_nodes_in, org_nextto_in, org_reach_in, org_alias_in) = org_in;

  <*Collect all fields to define*>
  all_fields = NULL;
  for(a = anchors; a != NULL; a = cdr(a)) {
    if(car(a) : CODE.FieldAnchor#(f_spec, f_impl)) {
      all_fields = XFORM.AppendList[erase_replicate=TRUE](f_spec, all_fields);
      if(!(f_impl : "UNMAPPED")) all_fields = XFORM.AppendList[erase_replicate=TRUE](f_impl, all_fields);
    }
  }
  foreach n = CODE.NextTo \in org_nextto_out do 
    all_fields = XFORM.AppendList[erase_replicate=TRUE](n[NextTo.type], all_fields); 
  enddo;
  foreach n = CODE.NextTo \in org_nextto_in do 
    all_fields = XFORM.AppendList[erase_replicate=TRUE](n[NextTo.type], all_fields); 
  enddo;
  for (pg_out = impl_spec; pg_out != NULL; pg_out = cdr(pg_out)) {
    CODE.OpSpec#(g_in, g_out) = car(pg_out);
    foreach n = CODE.NextTo \in g_in[GraphSpec.nextto] do 
      all_fields = XFORM.AppendList[erase_replicate=TRUE](n[NextTo.type], all_fields); 
    enddo;
    foreach n = CODE.NextTo \in g_out[GraphSpec.nextto] do
      all_fields = XFORM.AppendList[erase_replicate=TRUE](n[NextTo.type], all_fields); 
    enddo;
  }

  new_pos = XFORM.DifferenceList(org_nodes_out, org_nodes_in);
  deleted_pos = XFORM.DifferenceList(org_nodes_in, org_nodes_out);
  deleted_pos_code_templ = NULL;
  foreach p=ID \in deleted_pos do
    deleted_pos_code_templ = XFORM.AppendList[erase_replicate=TRUE](CODE.DeletedPosition#(p), deleted_pos_code_templ);
  enddo;
  org_nodes = AppendList[erase_replicate=1](org_nodes_in, new_pos);

  vars_to_declare = NULL;
  pos_variables = NULL;
  nextto_rels = reach_rels = alias_rels = NULL;
  index = 0;
  num_of_nodes = 0;

  for(nodes_in = org_nodes_in; nodes_in != NULL; nodes_in = cdr(nodes_in)){
    node_in = car(nodes_in);
    alias_rels = CODE.UnchangedPosition#(node_in, "in"^index, "out"^index) :: alias_rels; <*pos_in and pos_out are unchanged*>
    alias_rels = CODE.UnchangedPosition#(node_in, "in"^index, "eval"^index) :: alias_rels; <*pos_in and pos_eval are unchanged*>
  }

  for (pg_out = impl_spec; pg_out != NULL; pg_out = cdr(pg_out)) {
    CODE.OpSpec#(g_in, g_out) = car(pg_out);
    nodes_in = AppendList[erase_replicate=1](org_nodes_in, g_in[GraphSpec.nodes]);

    <***
      Output specification graph constraints
    ***>
    tag = "out" ^ index; 
    GraphSpec#(g_nodes_out, cur_nextto, cur_reach, cur_alias) = g_out;
    num_of_nodes = num_of_nodes + LEN(nodes_in) + LEN(g_nodes_out);
    <*NOTE: Fix added 1/14/25, don't create newly created position with _in tag'*>
    <*g_nodes_out = AppendList[erase_replicate=1](g_in[GraphSpec.nodes], g_nodes_out);*>
    <*cur_pos = AppendList[erase_replicate=1](org_nodes, g_nodes_out);*>
    org_nodes = AppendList[erase_replicate=1](org_nodes_out, deleted_pos);
    <*cur_pos = AppendList[erase_replicate=1](g_nodes_out,org_nodes);*>
    cur_pos = AppendList[erase_replicate=1](deleted_pos_code_templ,org_nodes);
    cur_nextto = AppendList[erase_replicate=1](org_nextto_out, cur_nextto);
    cur_reach = AppendList[erase_replicate=1](org_reach_out, cur_reach);
    cur_alias = AppendList[erase_replicate=1](org_alias_out, cur_alias);
    alias_rels = CODE.AliasDefinition#(tag, cur_alias) :: alias_rels;

    <*Generate NextTo and Reach definitions for all fields*>
    foreach f=ID \in all_fields do
      f_nextto = NULL;
      foreach n = CODE.NextTo \in cur_nextto do
        if(n[NextTo.type] == f) f_nextto = n :: f_nextto;
      enddo;
      nextto_rels = CODE.NextToDefinition#(f, tag, f_nextto) :: nextto_rels;

      f_reach = NULL;
      for(r = cur_reach; r != NULL; r = cdr(r)){
        node = car(r); target_f = "";
        if(node : CODE.ReachableTo#(f1,_,_)|CODE.NonCircleReachableTo#(f1,_,_)|CODE.NotNonCircleReachableTo#(f1,_,_)|CODE.NotReachableTo#(f1,_,_)) { target_f = f1; }
        if(target_f == f) f_reach = node :: f_reach;
      }
      reach_rels = CODE.ReachDefinition#(f, tag, f_reach) :: reach_rels;
    enddo;

    values = NULL;
    <*Collect specification value variables*>
    for(p=org_nodes_out; p != NULL; p = cdr(p)){
      if(car(p) : CODE.HasValue#(v1=_,v2=_)){
        values = XFORM.AppendList[erase_replicate=TRUE](CODE.ValueVariable#(tag, v2), values);
      }
    }

    <***
      Shape analysis output graph constraints
    ***>
    tag = "eval" ^ index;
    GraphSpec#(g_nodes_out, cur_nextto, cur_reach, cur_alias) = g_out;

    values_impl = NULL;
    <*Collect implementation value variables*>
    for(p=g_nodes_out; p != NULL; p = cdr(p)){
      if(car(p) : CODE.HasValue#(v1=_,v2=_)){
        values_impl = XFORM.AppendList[erase_replicate=TRUE](CODE.ValueVariable#(tag, v2), values_impl);
      }
    }

    for(p=anchors; p != NULL; p = cdr(p)){
      if(car(p) : CODE.ParamAnchor#(v1=_,v2=_)){
        if(!(v2 : "UNMAPPED")){
          values_impl = XFORM.AppendList[erase_replicate=TRUE](CODE.ValueVariable#(tag, v2), values_impl);
        }
      }
    }
    impl_pos_diff = XFORM.DifferenceList(g_nodes_out, org_nodes_in); <*Newly allocated nodes in implementation*>
    new_pos_impl = NULL;
    <*Unknown nodes are not new allocations*>
    <*TODO: Remove p_unknowns from list of newly allocated nodes*>
    for(impl_p=impl_pos_diff; impl_p != NULL; impl_p = cdr(impl_p)){
      if(car(SPLIT(9,car(impl_p))) != "p_unknown"){
        new_pos_impl = car(impl_p) :: new_pos_impl;
      }
    }
    new_pos_impl = XFORM.ReverseList(new_pos_impl);
    pos_variables = CODE.PositionVariableDefinition#(tag,cur_pos,new_pos,new_pos_impl,cur_alias) :: pos_variables;

    <***
      Input specification graph constraints
    ***>
    tag = "in" ^ index;
    alias_rels = CODE.AliasDefinition#(tag, org_alias_in) :: alias_rels;
    pos_variables = CODE.PositionVariableDefinition#(tag,org_nodes_in,NULL,NULL,org_alias_in) :: pos_variables;

    <*Generate NextTo and Reach definitions for all fields*>
    foreach f=ID \in all_fields do
      f_nextto = NULL;
      foreach n = CODE.NextTo \in org_nextto_in do
        if(n[NextTo.type] == f) f_nextto = n :: f_nextto;
      enddo;
      nextto_rels = CODE.NextToDefinition#(f, tag, f_nextto) :: nextto_rels;

      f_reach = NULL;
      for(r = org_reach_in; r != NULL; r = cdr(r)){
        node = car(r); target_f = "";
        if(node : CODE.ReachableTo#(f1,_,_)|CODE.NonCircleReachableTo#(f1,_,_)|CODE.NotNonCircleReachableTo#(f1,_,_)|CODE.NotReachableTo#(f1,_,_)) { target_f = f1; }
        if(target_f == f) f_reach = node :: f_reach;
      }
      reach_rels = CODE.ReachDefinition#(f, tag, f_reach) :: reach_rels;
    enddo;

    index = index + 1;
  }

  <*
  DEBUG{org_spec};
  DEBUG{pos_variables};
  DEBUG{deleted_pos};
  DEBUG{new_pos};
  DEBUG{alias_rels};
  DEBUG{values};
  DEBUG{values_impl};
  *>

  return SMTSpecification#(num_of_nodes, index, new_pos, pos_variables, anchors, nextto_rels, reach_rels, alias_rels, values, values_impl);
</xform>
