<code NextTo pars=(type:ID, n1:ID, n2:ID)/>

<code HasValue pars=(n1:ID, n2:ID)/>

<code ReachableTo pars=(type:ID, n1:ID, n2:ID)/>

<code NonCircleReachableTo pars=(type:ID, n1:ID, n2:ID)/>

<code NotNonCircleReachableTo pars=(type:ID, n1:ID, n2:ID)/>

<code NotReachableTo pars=(type:ID, n1:ID, n2:ID)/>

<code Alias pars=(v1:ID, v2:ID)/>

<code NotAlias pars=(v1:ID, v2:ID)/>

<code DeletedPosition pars=(n1:ID)/>

<code NewAllocPosition pars=(n1:ID)/>

