<code SMTOutput pars=(class_name:ID, spec_name:ID, content: LIST(CODE.SMTBlock, "\n"))>
@class_name
spec_name
content@
</code>

<code SMTBlock pars=(blockname : ID, op_name : ID, anchors : LIST(CODE.Anchor,""), smt_spec : CODE.SMTSpecification)>
@blockname
op_name
anchors
smt_spec@
</code>

<code SMTSpecification pars=(num_of_nodes : INT, 
                             num_of_graphs: INT, 
                             new_pos : LIST(ID, ","),
                             pos_variables : LIST(CODE.PositionVariableDefinition,","),
                             anchors : LIST(CODE.Anchor, ""), 
                             nextto_rels : LIST(CODE.NextToDefinition,"\n"),
                             reach_rels : LIST(CODE.ReachDefinition,"\n"),
                             aliases : LIST(CODE.AliasDefinition|CODE.UnchangedPosition, "\n"),
                             values :  LIST(CODE.ValueVariable, ""),
                             values_impl : LIST(CODE.ValueVariable, ""))>

(set-logic ALL)
(set-option :produce-models true)
(set-option :produce-unsat-cores true)

; Memory cells
(define-fun memory_cell ((l Int)) Bool
  (and (<= 0 l) (<= l @num_of_nodes@))
)

; deleted positions
(declare-fun deleted (Int) Bool)

; mapping function
(declare-fun mapping (Int) Int)
(assert (= 0 (mapping 0)))

; specification value variables
@((values == NULL)? "" : CODE.ValueVariableDefinition#("spec", values))@

; implementation value variables
@((values_impl == NULL)? "" : CODE.ValueVariableDefinition#("impl", values_impl))@

; Position and implementation variables
@((pos_variables == NULL)? "" : pos_variables)@

; definition of anchor/member variables
@CODE.AnchorVariableDefinition#(anchors, num_of_graphs, values, values_impl)@

; nextto relations
@((nextto_rels == NULL)? "" : nextto_rels)@

; reachable relations
@((reach_rels == NULL)? "" : reach_rels)@

; aliases
@((aliases == NULL)? "" : aliases)@

; binding of newly allocated positions
@CODE.NewAllocBinding#(pos_variables)@

; binding of member variables
@CODE.AnchorVariableBinding#(anchors, num_of_graphs)@

; general consistency rules
@CODE.AliasedPositionSameValueDefinition#(pos_variables)@
@CODE.PositionHasSingleValueDefinition#(pos_variables)@

(check-sat)
(get-model)
@CODE.GetValue#(pos_variables, anchors, num_of_graphs)@
(get-unsat-core)
</code>

<code GetValue pars=(pos_variables:LIST(CODE.PositionVariableDefinition,","), anchors : LIST(CODE.Anchor,","), n : INT)>
@(res2 = NULL;
for(pv_def = pos_variables; pv_def != NULL; pv_def = cdr(pv_def)){
  CODE.PositionVariableDefinition#(tag=_,cur_pos=_,new_pos=_,new_pos_impl=_,alias=_) = car(pv_def);
  foreach pos=ID \in cur_pos do
    res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.Variable#(pos,tag), res2);
    res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.VariableMapping#(pos,tag), res2);
  enddo;
}
for (p = anchors; p != NULL; p = cdr(p)) {
  anchor = car(p);
  if(anchor : CODE.FieldAnchor){
    continue;
  }else if(anchor : CODE.ParamAnchor#(v1=_,v2=_)){
    for (i = 0; i < n; i = i + 1) {
      res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.Variable#(v1,"post"^i), res2);
      res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.VariableMapping#(v1,"post"^i), res2);
      if(!(v2 : "UNMAPPED")){
        res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.Variable#(v2,"eval"^i), res2);
        res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.VariableMapping#(v2,"eval"^i), res2);
      }
    }
  }else{
    CODE.Anchor#(v1=_,v2=_) = anchor;
    for (i = 0; i < n; i = i + 1) {
      if(v2 : CODE.PtrAccess){
        res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.Variable#(v2[PtrAccess.ptr],"eval"^i), res2);
        res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.VariableMapping#(v2[PtrAccess.ptr],"eval"^i), res2);
      }
      res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.Variable#(v1,"pre"^i), res2);
      res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.VariableMapping#(v1,"pre"^i), res2);
      res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.Variable#(v1,"post"^i), res2);
      res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.VariableMapping#(v1,"post"^i), res2);
      if(!(v2 : "UNMAPPED")){
        res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.Variable#(v2,"eval"^i), res2);
        res2 = XFORM.AppendList[erase_replicate=TRUE](CODE.VariableMapping#(v2,"eval"^i), res2);
      }
    }
  }
})@
(get-value (@CODE.SMTVarName#(res2)@))
</code>

<code SMTVarName pars=(v : LIST(ID, " "))>
@v@
</code>

<code PositionVariableDefinition pars=(tag : ID, names : LIST(ID,","), new_pos : LIST(ID, ","), new_pos_impl : LIST(ID, ","), cur_alias : LIST(CODE.Alias|CODE.NotAlias,"\n"))>
@(res = NULL; unique = NULL; deleted_pos = NULL; values = NULL; p_val_pair = NULL; unique_impl = NULL; not_null_pos = NULL; unique_mapped = NULL;
for (p = names; p != NULL; p = cdr(p)) {
 if(car(p) : CODE.DeletedPosition#(del_pos=_)){
  deleted_pos = XFORM.AppendList[erase_replicate=TRUE](del_pos,deleted_pos);
  continue;
 }else if(car(p) : CODE.HasValue#(pos=_,val=_)){
  p_val_pair = car(p) :: p_val_pair;
  continue;
 }
 res = CODE.PositionVariable#(car(p), tag) :: res;
 if(car(SPLIT(9,car(p))) != "p_unknown"){
  not_null_pos = CODE.PositionVariableNotNull#(car(p), tag) :: not_null_pos;
  unique = XFORM.AppendList(car(p)^"_"^tag, unique);
 }
 if(XFORM.Lookup(car(p), new_pos)){
  for(q = names; q != NULL; q = cdr(q)){
    pos = car(q);
    if(!(pos : CODE.DeletedPosition|CODE.HasValue)){
      if(!XFORM.Lookup(pos, new_pos_impl) && !(car(p) : pos)){
        unique_mapped = XFORM.AppendList[erase_replicate=TRUE](CODE.UniquePosition#(tag, CODE.VariableMapping#(car(p),tag), CODE.VariableMapping#(pos,tag)), unique_mapped);
      }
    }
  }
 }else if(XFORM.Lookup(car(p), new_pos_impl)){
  for(q = names; q != NULL; q = cdr(q)){
    pos = car(q);
    if(!(pos : CODE.DeletedPosition|CODE.HasValue)){
      if(!XFORM.Lookup(pos, new_pos) && !(car(p) : pos)){
        unique_mapped = XFORM.AppendList[erase_replicate=TRUE](CODE.UniquePosition#(tag, CODE.VariableMapping#(car(p),tag), CODE.VariableMapping#(pos,tag)), unique_mapped);
      }
    }
  }
 }
}
res)@
@not_null_pos@
@((unique == NULL)? "" : CODE.PositionVariableDistinctAssert#(unique, tag, "spec"))@
@unique_mapped@
@((deleted_pos == NULL)? "" : CODE.PositionDeletedDefinition#(tag,deleted_pos))@
@(CODE.NewAllocDefinition#(tag, new_pos, new_pos_impl))@
@((p_val_pair == NULL)? "" : CODE.HasValueDefinition#(tag, p_val_pair))@
</code>

<code PositionVariableDistinctAssert pars=(names : LIST(ID," "), tag : ID, source: ID)>
(assert (! (distinct @names@) :named pos_variables_@tag@_are_distinct_@source@))
</code>

<code NewAllocDefinition pars=(tag:ID, new_pos : LIST(ID, ","), new_pos_impl : LIST(ID, ","))>
@(def=NULL; assertions=NULL;
for (p = new_pos; p != NULL; p = cdr(p)) {
  if(car(p) : CODE.DeletedPosition|CODE.HasValue){
    continue;
  }
  def = CODE.NewAllocExpression#(tag,car(p)) :: def;
  assertions = CODE.NewAllocAssert#(tag,car(p)) :: assertions;
}
for (p = new_pos_impl; p != NULL; p = cdr(p)) {
  if(car(p) : CODE.DeletedPosition|CODE.HasValue){
    continue;
  }
  def = CODE.NewAllocExpression#(tag,car(p)) :: def;
  assertions = CODE.NewAllocAssert#(tag,car(p)) :: assertions;
}
)@(define-fun new_alloc_@tag@ ((i Int)) Bool
  @((def : NULL|"")? "false"
   : (cdr(def) : ""|NULL)? def
   : ("(or " def ")"))@
)
@assertions@
</code>

<code NewAllocExpression pars=(tag:ID, var: ID)>
(= i @var@_@tag@)
</code>

<code NewAllocAssert pars=(tag:ID, var:ID)>
(assert (! (new_alloc_@tag@ @var@_@tag@) :named @var@_@tag@_is_new_alloc))
</code>

<code NewAllocMatch pars=(tag1: ID, v1: CODE.HasValue, tag2: ID, cur_pos: LIST(ID|CODE.HasValue,""))>
@(def=NULL; res=NULL;
for (p = cur_pos; p != NULL; p = cdr(p)) {
  cur_p = car(p);
  if(cur_p : CODE.DeletedPosition){
    continue;
  }else if(v1 : CODE.HasValue && cur_p : CODE.HasValue){
    <*def = CODE.NewAllocMatchPossible#(tag1, v1[HasValue.n1], tag2, cur_p[HasValue.n1]) :: def;*>
    res = CODE.PositionValueMatchPossible#(tag1, v1, tag2, cur_p) :: res;
  }else{
    def = CODE.NewAllocMatchPossible#(tag1, v1[HasValue.n1], tag2, cur_p) :: def;
  }
}
)@
@((def : NULL|"")? ""
   : (cdr(def) : ""|NULL)? ("(assert (! " def " :named " v1[HasValue.n1]"_"tag1"_is_matched_to_new_alloc))")
   : ("(assert (! (or " def ") :named " v1[HasValue.n1]"_"tag1"_is_matched_to_new_alloc))"))@
@((res : NULL|"")? "" : CODE.PositionValueMatchAssert#(tag1, v1, tag2, res))@
</code>

<code NewAllocMatchPossible pars=(tag1 : ID, v1: ID, tag2 : ID, v2: ID)>
(and (new_alloc_@tag1@ @v1@_@tag1@) (new_alloc_@tag2@ @v2@_@tag2@) (= (mapping @v1@_@tag1@) (mapping @v2@_@tag2@)))
</code>

<code PositionValueMatchPossible pars=(tag1: ID, v1 : CODE.HasValue, tag2 : ID, v2: CODE.HasValue)>
(= (mapping @v1[HasValue.n1]@_@tag1@) (mapping @v2[HasValue.n1]@_@tag2@))
</code>

<code PositionValueMatchAssert pars=(tag1: ID, v1 : CODE.HasValue, tag2 : ID, res: LIST(CODE.PositionValueMatchPossible,","))>
@(CODE.HasValue#(p,v) = v1;
(res : NULL|"")? ""
   : (cdr(res) : NULL|"")? ("(assert (! " res " :named " p"_"tag1"_value_"v"_is_matched))")
   : ("(assert (! (and " res ") :named " p"_"tag1"_value_"v"_is_matched))"))@
</code>

<code ValueVariableDefinition pars=(source: ID, names : LIST(CODE.ValueVariable, "\n"))>
@(vars=NULL; vars_mapped=NULL; diff_vars = NULL; diff_vars2 = NULL;
foreach cur1=CODE.ValueVariable#(vartag1=_,varname1=_) \in names do
  diff_vars = XFORM.AppendList(varname1^"_"^vartag1, diff_vars);
  diff_vars2 = XFORM.AppendList(CODE.VariableMapping#(varname1,vartag1), diff_vars2);
  foreach cur2=CODE.ValueVariable#(vartag2=_,varname2=_) \in names do
    if(!(varname1 : varname2)){
      diff_vars = XFORM.AppendList[erase_replicate=TRUE](varname2^"_"^vartag2, diff_vars);
      diff_vars2 = XFORM.AppendList[erase_replicate=TRUE](CODE.VariableMapping#(varname2,vartag2),diff_vars2);
    }
  enddo;
  if(cdr(diff_vars) : NULL){
    diff_vars = NULL;
    diff_vars2 = NULL;
    continue;
  }
  vars = CODE.ValueVariableDistinctAssert#(varname1^"_"^vartag1, diff_vars) :: vars;
  vars_mapped = XFORM.AppendList(CODE.ValueVariableMappingDistinctAssert#(varname1^"_"^vartag1, diff_vars2), vars_mapped);
  diff_vars = NULL;
  diff_vars2 = NULL;
enddo;

<*
foreach cur=CODE.ValueVariable#(vartag=_,varname=_) \in names do
  if(!(varname : "UNMAPPED")){
    vars = XFORM.AppendList(varname^_^vartag, vars);
    vars_mapped = XFORM.AppendList(CODE.VariableMapping#(varname,vartag), vars_mapped);
  }
enddo;
*>

)@
; definition of values (data stored in memory cells)
;(declare-sort Value)
@names@
@vars@
@vars_mapped@
</code>

<code ValueVariable pars=(tag : ID, name : ID)>
(declare-const @name@_@tag@ Int)
(assert (memory_cell @name@_@tag@))
</code>

<code ValueVariableDistinctAssert pars=(source: ID, names : LIST(ID," "))>
(assert (! (distinct @names@) :named @source@_value_variables_are_distinct))
</code>

<code ValueVariableMappingDistinctAssert pars=(source: ID, names : LIST(CODE.VariableMapping," "))>
(assert (! (distinct @names@) :named @source@_mapped_value_variables_are_distinct))
</code>

<code NewAllocBinding pars=(pos_variables:LIST(CODE.PositionVariableDefinition,","))>
@(res2 = NULL; new_alloc_out = NULL; new_alloc_eval = NULL; out_tag = NULL; eval_tag = NULL;
pos_out = NULL; pos_eval = NULL;
for(pv_def = pos_variables; pv_def != NULL; pv_def = cdr(pv_def)){
  cur_pv = car(pv_def);
  tag = cur_pv[PositionVariableDefinition.tag];
  if(car(SPLIT(4,tag)) == "post"){
    CODE.PositionVariableDefinition#(out_tag=_,pos_out=_,new_alloc_out=_,_,_) = car(pv_def);
  }else if(car(SPLIT(4,tag)) == "eval"){
    CODE.PositionVariableDefinition#(eval_tag=_,pos_eval=_,_,new_alloc_eval=_,_) = car(pv_def);
  }
}
for(p1 = new_alloc_out; p1 != NULL; p1 = cdr(p1)){
  if(car(p1) : CODE.HasValue){
    res2 = CODE.NewAllocMatch#(out_tag, car(p1), eval_tag, pos_eval) :: res2;
  }
}
for(p1 = new_alloc_eval; p1 != NULL; p1 = cdr(p1)){
  if(car(p1) : CODE.HasValue){
    res2 = CODE.NewAllocMatch#(eval_tag, car(p1), out_tag, pos_out) :: res2;
  }
})@
@((res2:NULL|"")? "" : res2)@
</code>

<code PositionDeletedDefinition pars=(tag:ID, deleted_pos:LIST(ID,""))>
@(res=NULL;
  for (p = deleted_pos; p != NULL; p = cdr(p)) {
    if(car(SPLIT(3,tag)) != "pre"){
      res = CODE.PositionDeletedAssert#(car(p), tag) :: res;
    }
  }
res)@
</code>

<code PositionDeletedAssert pars=(name:ID, tag:ID)>
(assert (! (deleted @name@_@tag@) :named @name@_@tag@_deleted))
</code>

<code UniquePosition pars=(tag : ID,v1 : CODE.VariableMapping, v2 : CODE.VariableMapping)>
(assert (! (not (= @v1@ @v2@)) :named p_unique_@v1[VariableMapping.v]@_@v2[VariableMapping.v]@_@tag@))
</code>

<code PositionVariable pars=(name : ID, tag : ID)>
(declare-const @name@_@tag@ Int)
(assert (memory_cell @name@_@tag@))
</code>

<code PositionVariableNotNull pars=(name: ID, tag : ID)>
(assert (! (not (= @name@_@tag@ 0)) :named p_not_null_@name@_@tag@))
(assert (! (not (= (mapping @name@_@tag@) (mapping 0))) :named p_mapping_not_null_@name@_@tag@))
</code>

<code AnchorVariableBinding pars=(anchors : LIST(CODE.Anchor,","), n : INT)>
@(res = NULL; res1 = NULL; res2 = NULL;
for (p = anchors; p != NULL; p = cdr(p)) {
 anchor = car p;
 if(anchor : CODE.ParamAnchor){
  <*
  CODE.ParamAnchor#(v1,v2) = anchor;
  for (i = 0; i < n; i = i + 1) {
    if(!(v2:"UNMAPPED")){
      res1 = CODE.BindingParams#(v1,v2,"post"^i,"eval"^i) :: res1;
    }
  }
  *>
 }else if(anchor : CODE.FieldAnchor){
  <*
  CODE.FieldAnchor#(v1,v2) = anchor;
  for (i = 0; i < n; i = i + 1) {
    if(!(v2:"UNMAPPED")){
      res2 = CODE.BindingField#(v1,v2,"post"^i,"eval"^i) :: res2;
    }
  }
  *>
 }else{
  Anchor#(v1,v2) = anchor;
  for (i = 0; i < n; i = i + 1) {
    if(!(v2:"UNMAPPED")){
      <*res = CODE.BindingAnchor#(v1,v2,"pre"^i,"eval"^i) :: res;*>
      res = CODE.BindingAnchor#(v1,v2,"post"^i,"eval"^i) :: res;
    }
  }
 }
} res)@
@res1@
@CODE.FieldReferenceBinding#(res2)@
</code>

<code FieldReferenceBinding pars=(mappings : LIST(CODE.BindingField,"\n"))>
@mappings@
</code>

<code BindingField pars=(spec_field:ID,impl_field:ID,tag1:ID,tag2:ID)>
(assert 
  (! (forall ((l Int) (r Int))
       (and (=> (nextto_@spec_field@_@tag1@ l r)
           (nextto_@impl_field@_@tag2@ (mapping l) (mapping r)))
            (=> (reach_@spec_field@_@tag1@ l r)
           (reach_@impl_field@_@tag2@ (mapping l) (mapping r)))
        ))
     :named verify_completeness_@spec_field@_@tag1@_to_@impl_field@_@tag2@)
)
</code>

<code AnchorVariableDefinition pars=(anchors : LIST(CODE.Anchor,","), n : INT, 
                                    values :  LIST(CODE.ValueVariable, ""),
                                    values_impl : LIST(CODE.ValueVariable, ""))>
@(res = NULL;
for (p = anchors; p != NULL; p = cdr(p)) {
 anchor = car p;
 if(anchor : CODE.ParamAnchor){
   CODE.ParamAnchor#(v1,v2) = anchor;
   for (i = 0; i < n; i = i + 1) {
    <*If function parameter is not a position, which is already declared*>
    if(!Lookup(v2,values_impl) && !(v2:"UNMAPPED")){
      res = XFORM.AppendList[erase_replicate=TRUE](CODE.ImplAnchorVariable#(v2, i), res);
    }
   }
   continue;
 }else if(anchor : CODE.FieldAnchor){
  continue;
 }
 Anchor#(v1,v2) = anchor;
 for (i = 0; i < n; i = i + 1) {
    if(v2 : CODE.PtrAccess){
      res = XFORM.AppendList(CODE.ImplAnchorVariable#(v2, i), res);
      res = XFORM.AppendList[erase_replicate=TRUE](CODE.ImplAnchorVariable#(v2[PtrAccess.ptr], i), res);
    }else if(!(v2:"UNMAPPED")){
      res = XFORM.AppendList[erase_replicate=TRUE](CODE.ImplAnchorVariable#(v2, i), res);
    }
    res = XFORM.AppendList[erase_replicate=TRUE](CODE.AnchorVariable#(v1, i), res);
 }
} res)@
</code>

<code AnchorVariable pars=(name : ID, index : INT)>
(declare-const @name@_pre@index@ Int)
(assert (memory_cell @name@_pre@index@))
(declare-const @name@_post@index@ Int)
(assert (memory_cell @name@_post@index@))
</code>

<code ImplAnchorVariable pars=(name : ID, index : INT)>
(declare-const @name@_eval@index@ Int)
(assert (memory_cell @name@_eval@index@))
</code>

<code BindingAnchor pars=(v1 : ID, v2 : ID, tag1 : ID, tag2: ID)>
(assert (! (= (mapping @v1@_@tag1@) (mapping @v2@_@tag2@)) :named binding_@v1@_@tag1@_@v2@_@tag2@))
</code>

<code BindingParams pars=(v1 : ID, v2 : ID, tag1 : ID, tag2: ID)>
(assert (! (= (mapping @v1@_@tag1@) (mapping @v2@_@tag2@)) :named binding_@v1@_@tag1@_@v2@_@tag2@))
</code>

<code NextToDefinition pars=(field: ID, tag: ID, rels: LIST(CODE.NextTo, "\n"))>
@(res1 = res2 = NULL;
 foreach n = CODE.NextTo \in rels do
   res1 = (CODE.NextToPossible#(tag, n)) :: res1;
   res2 = (CODE.NextToAssert#(tag, n, field)) :: res2;
 enddo
)@(define-fun nextto_@field@_@tag@ ((l Int) (r Int)) Bool
  @((res1 : NULL|"")? "false"
   : (cdr(res1) : ""|NULL)? res1
   : ("(or " res1 ")"))@)
@res2@
</code>

<*
<code NextToDefinition pars=(tag:ID, rels : LIST(CODE.NextTo,"\n"))>
@(res1 = res2 = fields = NULL;
 foreach n = CODE.NextTo \in rels do
   fields = XFORM.AppendList[erase_replicate=TRUE](n[NextTo.type], fields);
 enddo;
 res_blocks = NULL;
 foreach f = ID \in fields do
  field_possibilities = NULL;
  field_asserts = NULL;
  foreach n = CODE.NextTo \in rels do
    if(n[NextTo.type] == f){
      field_possibilities = (CODE.NextToPossible#(tag, n)) :: field_possibilities;
      field_asserts = (CODE.NextToAssert#(tag, n, f)) :: field_asserts;
    }
  enddo;
  res_blocks = CODE.NextToBlock#(f,tag,field_possibilities,field_asserts) :: res_blocks;
 enddo;
)@
@res_blocks@
</code>
*>

<code NextToBlock pars=(field: ID, tag: ID, res1 : LIST(CODE.NextToPossible," "), res2 :  LIST(CODE.NextToAssert, " "))>
(define-fun nextto_@field@_@tag@ ((l Int) (r Int)) Bool
  @((res1 : NULL|"")? "false"
   : (cdr(res1) : ""|NULL)? res1
   : ("(or " res1 ")"))@)
@res2@
</code>

<code NextToPossible pars=(tag, r : CODE.NextTo) >
(and (= l @r[NextTo.n1]@_@tag@)  (= r @r[NextTo.n2]@_@tag@)  (not (= l r)) (not (= (mapping l) (mapping r))))
</code>

<code NextToAssert pars=(tag : ID, r : CODE.NextTo, field : ID)>
(assert (!(nextto_@field@_@tag@ @r[NextTo.n1]@_@tag@ @r[NextTo.n2]@_@tag@) :named nextto_@field@_@tag@_@r[NextTo.n1]@_@r[NextTo.n2]@))
</code>

<code ReachDefinition pars=(field: ID, tag: ID, rels: LIST(CODE.ReachableTo|CODE.NonCircleReachableTo|CODE.NotNonCircleReachableTo|CODE.NotReachableTo, "\n"))>
@(res1 = res2 = res3 = res4 = NULL;
  for(n=rels; n != NULL; n=cdr(n)){
    if(car(n) : CODE.ReachableTo){
      res1 = (CODE.ReachableToPossible#(tag, car(n))) :: res1;
      res2 = (CODE.ReachableToAssert#(tag, car(n), field)) :: res2;
    }else if(car(n) : CODE.NotReachableTo){
      res3 = (CODE.NotReachableAssert#(tag, car(n), field)) :: res3;
    }else if(car(n) : CODE.NotNonCircleReachableTo|CODE.NonCircleReachableTo){
      res4 = car(n) :: res4;
    }
  }
)@(define-fun-rec reachable_@field@_@tag@ ((l Int) (r Int)) Bool
  (or
    @res1@
    (= l r)
    (nextto_@field@_@tag@ l r)
    (exists ((m Int)) (and (nextto_@field@_@tag@ l m) (reachable_@field@_@tag@ m r)))
    (exists ((m Int)) (and (reachable_@field@_@tag@ l m) (nextto_@field@_@tag@ m r)))
  )
)
@res2@
@res3@
@CODE.NotCircleDefinition#(tag,res4,field)@
</code>

<*
<code ReachDefinition pars=(tag:ID, rels : LIST(CODE.ReachableTo|CODE.NonCircleReachableTo|CODE.NotNonCircleReachableTo|CODE.NotReachableTo,"\n"))>
@(fields = NULL;
for(n=rels; n != NULL; n=cdr(n)){
  CODE.ReachableTo#(field=_,_,_)|CODE.NonCircleReachableTo#(field=_,_,_)|CODE.NotNonCircleReachableTo#(field=_,_,_)|CODE.NotReachableTo#(field=_,_,_) = car(n);
  fields = XFORM.AppendList[erase_replicate=TRUE](field, fields);
}
res_blocks = NULL;
foreach f=ID \in fields do
  field_possibilities = NULL;
  field_asserts = NULL;
  res3 = NULL;
  res4 = NULL;
  for(n=rels; n != NULL; n=cdr(n)){
    if(car(n) : CODE.ReachableTo#(field_target=_,_,_)){
      if(XFORM.Lookup(f, field_target)){
        field_possibilities = (CODE.ReachableToPossible#(tag, car(n))) :: field_possibilities;
        field_asserts = (CODE.ReachableToAssert#(tag, car(n), field_target)) :: field_asserts;
      }
    }else if(car(n) : CODE.NotReachableTo#(field_target=_,_,_)){
      if(XFORM.Lookup(f, field_target)){
        res3 = (CODE.NotReachableAssert#(tag,car(n),field_target)) :: res3;
      }
    }else if(car(n) : CODE.NotNonCircleReachableTo#(field_target=_,_,_)|CODE.NonCircleReachableTo#(field_target=_,_,_)){
      if(XFORM.Lookup(f, field_target)){
        res4 = car(n) :: res4;
      }
    }
  }
  res_blocks = CODE.ReachableToBlock#(f, tag, field_possibilities, field_asserts, res3, res4) :: res_blocks;
enddo;)@
@res_blocks@
</code>
*>

<code ReachableToBlock pars=(field: ID, tag: ID, res1 : LIST(CODE.ReachableToPossible," "), res2 :  LIST(CODE.ReachableToAssert, " "), res3 :  LIST(CODE.NotReachableAssert, " "), res4 :  LIST(CODE.NonCircleReachableTo|CODE.NotNonCircleReachableTo, " "))>
(define-fun-rec reachable_@field@_@tag@ ((l Int) (r Int)) Bool
  (or
    @res1@
    (= l r)
    (nextto_@field@_@tag@ l r)
    (exists ((m Int)) (and (nextto_@field@_@tag@ l m) (reachable_@field@_@tag@ m r)))
    (exists ((m Int)) (and (reachable_@field@_@tag@ l m) (nextto_@field@_@tag@ m r)))
  )
)
@res2@
@res3@
@CODE.NotCircleDefinition#(tag,res4,field)@
</code>

<code ReachableToPossible pars=(tag : ID, r : CODE.ReachableTo)>
(and (= l @r[ReachableTo.n1]@_@tag@)  (= r @r[ReachableTo.n2]@_@tag@))
</code>

<code ReachableToAssert pars=(tag : ID, r : CODE.ReachableTo, field : ID)>
(assert (!(reachable_@field@_@tag@ @r[ReachableTo.n1]@_@tag@ @r[ReachableTo.n2]@_@tag@) :named reach_@field@_@tag@_@r[ReachableTo.n1]@_@r[ReachableTo.n2]@))
</code>

<code NotReachableAssert pars=(tag : ID, r : CODE.NotReachableTo, field : ID)>
(assert (!(not (reachable_@field@_@tag@ @r[NotReachableTo.n1]@_@tag@ @r[NotReachableTo.n2]@_@tag@)) :named not_reach_@field@_@tag@_@r[NotReachableTo.n1]@_@r[NotReachableTo.n2]@))
</code>

<code NotCircleDefinition pars=(tag:ID, r: LIST(CODE.ReachableTo|CODE.NonCircleReachableTo|CODE.NotNonCircleReachableTo,""), field : ID)>
@(res1 = res2 = NULL;
foreach n = CODE.NonCircleReachableTo \in r do
  res1 = (CODE.NotCircleAssert#(tag,n,field)) :: res1;
enddo;
foreach n = CODE.NotNonCircleReachableTo \in r do
  res2 = (CODE.NotNotCircleAssert#(tag,n,field)) :: res2;
enddo;
)@
(define-fun non_empty_is_non_circle_@field@_@tag@ ((n Int) (m Int)) Bool
  (=> 
    (exists ((p1 Int) (p2 Int))
      (and 
        (reachable_@field@_@tag@ n p1)
        (nextto_@field@_@tag@ p1 p2)
        (reachable_@field@_@tag@ p2 m)
      )
    )
    (not (= n m))
  )
)
@res1@
@res2@
</code>

<code NotCircleAssert pars=(tag:ID, r: CODE.NonCircleReachableTo, field : ID)>
(assert (!(non_empty_is_non_circle_@field@_@tag@ @r[NonCircleReachableTo.n1]@_@tag@ @r[NonCircleReachableTo.n2]@_@tag@) :named non_empty_is_non_circle_@field@_@tag@_@r[NonCircleReachableTo.n1]@_@r[NonCircleReachableTo.n2]@))
</code>

<code NotNotCircleAssert pars=(tag:ID, r: CODE.NotNonCircleReachableTo, field : ID)>
(assert (!(not (non_empty_is_non_circle_@field@_@tag@ @r[NotNonCircleReachableTo.n1]@_@tag@ @r[NotNonCircleReachableTo.n2]@_@tag@)) :named not_non_empty_is_non_circle_@field@_@tag@_@r[NotNonCircleReachableTo.n1]@_@r[NotNonCircleReachableTo.n2]@))
</code>

<code AliasDefinition pars=(tag : ID, rels : LIST(CODE.Alias|CODE.NotAlias, "\n"))>
@(res = NULL;
foreach n = CODE.Alias \in rels do
  res = (CODE.AliasAssert#(tag,n)) :: res;
enddo
foreach n = CODE.NotAlias \in rels do
  res = (CODE.NotAliasAssert#(tag,n)) :: res;
enddo
res)@
</code>

<code AliasAssert pars=(tag:ID, r : CODE.Alias) p=NULL>
@CODE.Alias#(v1,v2) = r; 
if(v1 == "null"){
  v1 = 0;
}else if(v1 : CODE.PtrAccess){
  v1 = CODE.Variable#(v1,tag);
}else{
  v1 = v1 ^ "_" ^ tag
}
if (v2 == "null")  v2 = 0;
else v2 = v2 ^ "_" ^ tag;
@(assert (! (= @v1@ @v2@) :named alias_@v1@_@v2@))
(assert (! (= (mapping @v1@) (mapping @v2@)) :named alias_mapped_@v1@_@v2@))
</code>

<code NotAliasAssert pars=(tag:ID, r : CODE.NotAlias) p=NULL>
@CODE.NotAlias#(v1,v2) = r; 
if (v1 == "null")  v1 = 0;
else v1 = v1 ^ "_" ^ tag;
if (v2 == "null")  v2 = 0;
else v2 = v2 ^ "_" ^ tag;
@(assert (! (not (= @v1@ @v2@)) :named notalias_@v1@_@v2@))
(assert (! (not (= (mapping @v1@) (mapping @v2@))) :named notalias_mapped_@v1@_@v2@))
</code>

<code UnchangedPosition pars=(v : ID, tag1 : ID, tag2 : ID)>
(assert (! (= @v@_@tag1@ @v@_@tag2@) :named unchanged_@v@_@tag1@_@tag2@))
</code>

<code HasValueDefinition pars=(tag : ID, rels: LIST(CODE.HasValue,""))>
@(res1 = res2 = NULL;
foreach h = CODE.HasValue \in rels do
  res1 = (CODE.HasValuePossible#(tag, h)) :: res1;
  res2 = (CODE.HasValueAssert#(tag, h)) :: res2;
enddo;
)@(define-fun has_value_@tag@ ((l Int) (r Int)) Bool
    @((res1 : NULL|"")? "false"
   : (cdr(res1) : ""|NULL)? res1
   : ("(or " res1 ")"))@)
@res2@
</code>

<code HasValuePossible pars=(tag, r : CODE.HasValue) >
(and (= l @r[HasValue.n1]@_@tag@)  (= r @r[HasValue.n2]@_@tag@))
</code>

<code HasValueAssert pars=(tag : ID, r : CODE.HasValue)>
(assert (! (has_value_@tag@ @r[HasValue.n1]@_@tag@ @r[HasValue.n2]@_@tag@) :named has_value_@tag@_@r[HasValue.n1]@_@r[HasValue.n2]@))
</code>

<code AliasedPositionSameValueDefinition pars=(pos_variables : LIST(CODE.PositionVariableDefinition,","))>
@(res=NULL;
for(q = pos_variables; q != NULL; q = cdr(q)){
  cur_q = car(q);
  names = cur_q[PositionVariableDefinition.names];
  for(n = names; n != NULL; n = cdr(n)){
    if(car(n) : CODE.HasValue){
      res = CODE.AliasedPositionSameValueAssert#(cur_q[PositionVariableDefinition.tag]) :: res;
      break;
    }
  }
})@
@res@
</code>

<code AliasedPositionSameValueAssert pars=(tag: ID)>
(assert 
  (! (forall ((c1 Int) (c2 Int) (v1 Int) (v2 Int))
         (=>(and (not (= c1 c2))
              (has_value_post0 c1 v1) 
              (has_value_eval0 c2 v2) 
              (= (mapping c1) (mapping c2)))
         (= (mapping v1) (mapping v2)))
      )
     :named aliased_positions_@tag@_hold_same_value)
)
</code>

<code PositionHasSingleValueDefinition pars=(pos_variables : LIST(CODE.PositionVariableDefinition,","))>
@(res=NULL;
for(q = pos_variables; q != NULL; q = cdr(q)){
  cur_q = car(q);
  names = cur_q[PositionVariableDefinition.names];
  for(n = names; n != NULL; n = cdr(n)){
    if(car(n) : CODE.HasValue){
      res = CODE.PositionHasSingleValueAssert#(cur_q[PositionVariableDefinition.tag]) :: res;
      break;
    }
  }
})@
@res@
</code>

<code PositionHasSingleValueAssert pars=(tag : ID)>
(assert 
  (! (forall ((c Int) (v1 Int) (v2 Int))
       (=> 
         (and (has_value_@tag@ c v1) 
              (has_value_@tag@ c v2))
         (= v1 v2)))
     :named positions_@tag@_have_single_value)
)
</code>

<code VariableMapping pars=(v:ID,tag:ID)>
(mapping @v@_@tag@)
</code>

<code Variable pars=(v:ID,tag:ID)>
@v@_@tag@
</code>

<code ObjAccess pars=(obj:EXP,fd:ID)> @obj@.@fd@ </code>

<code PtrAccess pars=(ptr:EXP,fd:ID)> @ptr@->@fd@ </code>

<code HasValue pars=(n1:ID, n2:ID)/>

<code NullData>
null
</code>
