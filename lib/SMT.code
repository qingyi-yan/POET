<code SMTOutput pars=(class_name:ID, spec_name:ID, content: LIST(CODE.SMTBlock, "\n"))>
@class_name
spec_name
content@
</code>

<code SMTBlock pars=(blockname : ID, op_name : ID, anchors : LIST(CODE.Anchor,""), smt_spec : CODE.SMTSpecification)>
@blockname
op_name
anchors
smt_spec@
</code>

<code SMTSpecification pars=(num_of_nodes : INT, 
                             num_of_graphs: INT, 
                             new_pos : LIST(ID, ","),
                             pos_variables : LIST(CODE.PositionVariableDefinition,","),
                             anchors : LIST(CODE.Anchor, ""), 
                             nextto_rels : LIST(CODE.NextToDefinition,"\n"),
                             reach_rels : LIST(CODE.ReachDefinition,"\n"),
                             aliases : LIST(CODE.AliasDefinition|CODE.UnchangedPosition|CODE.UnchangedVariable, "\n"),
                             values :  LIST(CODE.ValueVariable, ""),
                             values_impl : LIST(CODE.ValueVariable, ""))>

(set-logic ALL)
(set-option :produce-models true)
(set-option :produce-unsat-cores true)

; Memory cells
(define-fun memory_cell ((l Int)) Bool
  (and (<= 0 l) (<= l @num_of_nodes@))
)

; deleted positions
(declare-fun deleted (Int) Bool)

; specification value variables
@((values == NULL)? "" : CODE.ValueVariableDefinition#("spec", values))@

; implementation value variables
@((values_impl == NULL)? "" : CODE.ValueVariableDefinition#("impl", values_impl))@

; Position and implementation variables
@((pos_variables == NULL)? "" : pos_variables)@

; definition of anchor/member variables
@CODE.AnchorVariableDefinition#(anchors, num_of_graphs, values, values_impl)@

; nextto relations
@((nextto_rels == NULL)? "" : nextto_rels)@

; reachable relations
@((reach_rels == NULL)? "" : reach_rels)@

; aliases
@((aliases == NULL)? "" : aliases)@

; binding of newly allocated positions
@CODE.NewAllocBinding#(pos_variables)@

; binding of member variables
@CODE.AnchorVariableBinding#(anchors, num_of_graphs)@

; general consistency rules
@CODE.AliasedPositionSameValueDefinition#(pos_variables)@
@CODE.PositionHasSingleValueDefinition#(pos_variables)@

(check-sat)
(get-model)
(get-unsat-core)
</code>

<code PositionVariableDefinition pars=(tag : ID, names : LIST(ID,","), new_pos : LIST(ID, ","), new_pos_impl : LIST(ID, ","), cur_alias : LIST(CODE.Alias|CODE.NotAlias,"\n"))>
@(res = NULL; unique = NULL; deleted_pos = NULL; values = NULL; p_val_pair = NULL;
for (p = names; p != NULL; p = cdr(p)) {
 if((car(p)) : CODE.DeletedPosition#(del_pos=_)){
  deleted_pos = XFORM.AppendList[erase_replicate=TRUE](del_pos,deleted_pos);
  continue;
 }else if((car(p)) : CODE.HasValue#(pos=_,val=_)){
  p_val_pair = car(p) :: p_val_pair;
  continue;
 }
 res = CODE.PositionVariable#(car(p), tag) :: res;
 for(p1 = names; p1 != NULL; p1 = cdr(p1)){
  if((car(p1)) : CODE.DeletedPosition|CODE.HasValue){
    continue;
  }
  if(car(p) != car(p1)){
    if(Lookup(car(p), new_pos) && !(Lookup(car(p1), new_pos) || Lookup(car(p1), new_pos_impl))){
      unique = CODE.UniquePosition#(tag, car(p), car(p1)) :: unique;
    }else if(Lookup(car(p), new_pos_impl) && !(Lookup(car(p1), new_pos) || Lookup(car(p1), new_pos_impl))){
      unique = CODE.UniquePosition#(tag, car(p), car(p1)) :: unique;
    }else if(car(SPLIT(9,car(p))) == "p_unknown"){
      if(Lookup(car(p1), new_pos) || Lookup(car(p1), new_pos_impl)){
        unique = CODE.UniquePosition#(tag, car(p), car(p1)) :: unique;
      }
    }
  }
 }
}
res)@
@unique@
@((deleted_pos == NULL)? "" : CODE.PositionDeletedDefinition#(tag,deleted_pos))@
@((new_pos == NULL && new_pos_impl == NULL)? "" : CODE.NewAllocDefinition#(tag, new_pos, new_pos_impl))@
@((p_val_pair == NULL)? "" : CODE.HasValueDefinition#(tag, p_val_pair))@
</code>

<code NewAllocDefinition pars=(tag:ID, new_pos : LIST(ID, ","), new_pos_impl : LIST(ID, ","))>
@(def=NULL; assertions=NULL;
for (p = new_pos; p != NULL; p = cdr(p)) {
  if((car(p)) : CODE.DeletedPosition|CODE.HasValue){
    continue;
  }
  def = CODE.NewAllocExpression#(tag,car(p)) :: def;
  assertions = CODE.NewAllocAssert#(tag,car(p)) :: assertions;
}
for (p = new_pos_impl; p != NULL; p = cdr(p)) {
  if((car(p)) : CODE.DeletedPosition|CODE.HasValue){
    continue;
  }
  def = CODE.NewAllocExpression#(tag,car(p)) :: def;
  assertions = CODE.NewAllocAssert#(tag,car(p)) :: assertions;
}
)@(define-fun new_alloc_@tag@ ((i Int)) Bool
  @((def : NULL|"")? "false"
   : (cdr(def) : ""|NULL)? def
   : ("(or " def ")"))@
)
@assertions@
</code>

<code NewAllocExpression pars=(tag:ID, var: ID)>
(= i @var@_@tag@)
</code>

<code NewAllocAssert pars=(tag:ID, var:ID)>
(assert (! (new_alloc_@tag@ @var@_@tag@) :named @var@_@tag@_is_new_alloc))
</code>

<code NewAllocMatch pars=(tag:ID, v1: ID|CODE.HasValue, cur_pos: LIST(ID,","))>
@(def=NULL; res=NULL;
for (p = cur_pos; p != NULL; p = cdr(p)) {
  if(car(p) : v1){
    continue;
  }else if(car(p) : CODE.DeletedPosition){
    continue;
  }else if(v1 : CODE.HasValue && car(p) : CODE.HasValue){
    res = CODE.PositionValueMatchPossible#(tag, v1, car(p)) :: res;
    continue;
  }else if(v1 : CODE.HasValue || car(p) : CODE.HasValue){
    continue;
  }
  def = CODE.NewAllocMatchPossible#(tag, v1, car(p)) :: def;
}
)@
@((def : NULL|"")? ""
   : (cdr(def) : ""|NULL)? ("(assert (!" def ":named @v1@_@tag@_is_matched_to_new_alloc))")
   : ("(assert (! (or " def ") :named " v1"_"tag"_is_matched_to_new_alloc))"))@
@((res : NULL|"")? "" : CODE.PositionValueMatchAssert#(tag, v1, res))@
</code>

<code NewAllocMatchPossible pars=(tag : ID, v1: ID, v2: ID)>
(and (new_alloc_@tag@ @v2@_@tag@) (= @v1@_@tag@ @v2@_@tag@))
</code>

<code PositionValueMatchPossible pars=(tag: ID, v1 : CODE.HasValue, v2: CODE.HasValue)>
(=> (= @v1[HasValue.n1]@_@tag@ @v2[HasValue.n1]@_@tag@) (= @v1[HasValue.n2]@_@tag@ @v2[HasValue.n2]@_@tag@))
</code>

<code PositionValueMatchAssert pars=(tag: ID, v1 : CODE.HasValue, res: LIST(CODE.PositionValueMatchPossible,","))>
@(CODE.HasValue#(p,v) = v1;
(res : NULL|"")? ""
   : (cdr(res) : ""|NULL)? ("(assert (! " res " :named @p@_@tag@_value_@v@_is_matched))")
   : ("(assert (! (and " res ") :named " p"_"tag"_value_"v"_is_matched))"))@
</code>

<code ValueVariableDefinition pars=(source: ID, names : LIST(CODE.ValueVariable, "\n"))>
@(vars=NULL;
foreach cur=CODE.ValueVariable#(vartag=_,varname=_) \in names do
  vars = XFORM.AppendList(varname^_^vartag, vars);
enddo;)@
; definition of values (data stored in memory cells)
;(declare-sort Value)
@names@
@CODE.ValueVariableDistinctAssert#(source, vars)@
</code>

<code ValueVariable pars=(tag : ID, name : ID)>
(declare-const @name@_@tag@ Int)
(assert (memory_cell @name@_@tag@))
</code>

<code ValueVariableDistinctAssert pars=(source: ID, names : LIST(ID," "))>
(assert (! (distinct @names@) :named @source@_value_variables_are_distinct))
</code>

<code NewAllocBinding pars=(pos_variables:LIST(CODE.PositionVariableDefinition,","))>
@(res2 = NULL;
for(pv_def = pos_variables; pv_def != NULL; pv_def = cdr(pv_def)){
  CODE.PositionVariableDefinition#(tag=_,cur_pos=_,new_pos=_,new_pos_impl=_,alias=_) = car(pv_def);
  for(p1 = new_pos; p1 != NULL; p1 = cdr(p1)){
    res2 = CODE.NewAllocMatch#(tag,car(p1),cur_pos) :: res2;
  }
})@
@((res2:NULL|"")? "" : res2)@
</code>

<code PositionDeletedDefinition pars=(tag:ID, deleted_pos:LIST(ID,""))>
@(res=NULL;
  for (p = deleted_pos; p != NULL; p = cdr(p)) {
    if(car(SPLIT(2,tag)) != "in"){
      res = CODE.PositionDeletedAssert#(car(p), tag) :: res;
    }
  }
res)@
</code>

<code PositionDeletedAssert pars=(name:ID, tag:ID)>
(assert (! (deleted @name@_@tag@) :named @name@_@tag@_deleted))
</code>

<code UniquePosition pars=(tag : ID,v1 : ID, v2 : ID)>
(assert (! (not (= @v1@_@tag@ @v2@_@tag@)) :named p_unique_@v1@_@v2@_@tag@))
</code>

<code PositionVariable pars=(name : ID, tag : ID)>
(declare-const @name@_@tag@ Int)
(assert (memory_cell @name@_@tag@))
(assert (! (not (= @name@_@tag@ 0)) :named p_not_null_@name@_@tag@))
</code>

<code AnchorVariableBinding pars=(anchors : LIST(CODE.Anchor,","), n : INT)>
@(res = NULL; res1 = NULL;
for (p = anchors; p != NULL; p = cdr(p)) {
 anchor = car p;
 if(anchor : CODE.ParamAnchor){
  CODE.ParamAnchor#(v1,v2) = anchor;
  for (i = 0; i < n; i = i + 1) {
    res1 = CODE.BindingParams#(v1,v2,"out"^i) :: res1;
  }
  continue;
 }
 Anchor#(v1,v2) = anchor;
 for (i = 0; i < n; i = i + 1) {
   if(!(v2:"UNMAPPED")){
    res = CODE.BindingAnchor#(v1,v2,"in"^i) :: res;
    res = CODE.BindingAnchor#(v1,v2,"out"^i) :: res;
   }
 }
} res)@
@res1@
</code>

<code AnchorVariableDefinition pars=(anchors : LIST(CODE.Anchor,","), n : INT, 
                                    values :  LIST(CODE.ValueVariable, ""),
                                    values_impl : LIST(CODE.ValueVariable, ""))>
@(res = NULL;
for (p = anchors; p != NULL; p = cdr(p)) {
 anchor = car p;
 if(anchor : CODE.ParamAnchor){
   CODE.ParamAnchor#(v1,v2) = anchor;
   for (i = 0; i < n; i = i + 1) {
    <*If function parameter is not a position, which is already declared*>
    if(!Lookup(v2,values_impl)){
      res = XFORM.AppendList[erase_replicate=TRUE](CODE.AnchorVariable#(v2, i), res);
    }
   }
   continue;
 }
 Anchor#(v1,v2) = anchor;
 for (i = 0; i < n; i = i + 1) {
    if(!(v2:"UNMAPPED")){
      res = CODE.AnchorVariable#(v2, i) :: res;
    }
    res = CODE.AnchorVariable#(v1, i) :: res;
 }
} res)@
</code>

<code AnchorVariable pars=(name : ID, index : INT)>
(declare-const @name@_in@index@ Int)
(assert (memory_cell @name@_in@index@))
(declare-const @name@_out@index@ Int)
(assert (memory_cell @name@_out@index@))
</code>

<code BindingAnchor pars=(v1 : ID, v2 : ID, tag : ID)>
(assert (! (or (= @v1@_@tag@ @v2@_@tag@) (and (= @v1@_@tag@ 0) (nextto_@tag@ @v1@_@tag@ @v2@_@tag@))) :named binding_@v1@_@v2@_@tag@))
</code>

<code BindingParams pars=(v1 : ID, v2 : ID, tag : ID)>
(assert (! (= @v1@_@tag@ @v2@_@tag@) :named binding_@v1@_@v2@_@tag@))
</code>

<code NextToDefinition pars=(tag:ID, rels : LIST(CODE.NextTo,"\n"))>
@(res1 = res2 = NULL;
 foreach n = CODE.NextTo \in rels do
   res1 = (CODE.NextToPossible#(tag, n)) :: res1;
   res2 = (CODE.NextToAssert#(tag,n)) :: res2;
 enddo
)@(define-fun nextto_@tag@ ((l Int) (r Int)) Bool
  @((res1 : NULL|"")? "false"
   : (cdr(res1) : ""|NULL)? res1
   : ("(or " res1 ")"))@)
@res2@
</code>

<code NextToPossible pars=(tag, r : CODE.NextTo) >
(and (= l @r[NextTo.n1]@_@tag@)  (= r @r[NextTo.n2]@_@tag@)  (not (= l r)))
</code>

<code NextToAssert pars=(tag : ID, r : CODE.NextTo)>
(assert (!(nextto_@tag@ @r[NextTo.n1]@_@tag@ @r[NextTo.n2]@_@tag@) :named nextto_@tag@_@r[NextTo.n1]@_@r[NextTo.n2]@))
</code>

<code ReachDefinition pars=(tag:ID, rels : LIST(CODE.ReachableTo|CODE.NonCircleReachableTo|CODE.NotReachableTo,"\n"))>
@(res1 = res2 = res3 = NULL;
foreach n = CODE.ReachableTo \in rels do
  res1 = (CODE.ReachableToPossible#(tag,n)) :: res1;
  res2 = (CODE.ReachableToAssert#(tag,n)) :: res2;
enddo
foreach m = CODE.NotReachableTo \in rels do
  res3 = (CODE.NotReachableAssert#(tag,m)) :: res3;
enddo;
)@
(define-fun-rec reachable_@tag@ ((l Int) (r Int)) Bool
  (or
    @res1@
    (= l r)
    (nextto_@tag@ l r)
    (exists ((m Int)) (and (nextto_@tag@ l m) (reachable_@tag@ m r)))
    (exists ((m Int)) (and (reachable_@tag@ l m) (nextto_@tag@ m r)))
  )
)
@res2@
@res3@
</code>

<code ReachableToPossible pars=(tag : ID, r : CODE.ReachableTo)>
(and (= l @r[ReachableTo.n1]@_@tag@)  (= r @r[ReachableTo.n2]@_@tag@) (<= l r))
</code>

<code ReachableToAssert pars=(tag : ID, r : CODE.ReachableTo)>
(assert (!(reachable_@tag@ @r[ReachableTo.n1]@_@tag@ @r[ReachableTo.n2]@_@tag@) :named reach_@tag@_@r[ReachableTo.n1]@_@r[ReachableTo.n2]@))
</code>

<code NotReachableAssert pars=(tag : ID, r : CODE.NotReachableTo)>
(assert (!(not (reachable_@tag@ @r[NotReachableTo.n1]@_@tag@ @r[NotReachableTo.n2]@_@tag@)) :named not_reach_@tag@_@r[NotReachableTo.n1]@_@r[NotReachableTo.n2]@))
</code>

<code NotCircleDefinition pars=(tag:ID, r: LIST(CODE.ReachableTo|CODE.NonCircleReachableTo,""))>
@(res1 = NULL;
foreach n = CODE.NonCircleReachableTo \in r do
  res1 = (CODE.NotCircleAssert#(tag,n)) :: res1;
enddo
)@
(define-fun non_empty_is_non_circle_@tag@ ((n Int) (m Int)) Bool
  (=> 
    (exists ((p1 Int) (p2 Int))
      (and 
        (reachable_@tag@ n p1)
        (nextto_@tag@ p1 p2)
        (reachable_@tag@ p2 m)
      )
    )
    (not (= n m))
  )
)
@res1@
</code>

<code NotCircleAssert pars=(tag:ID, r: CODE.NonCircleReachableTo)>
(assert (!(non_empty_is_non_circle_@tag@ @r[NonCircleReachableTo.n1]@_@tag@ @r[NonCircleReachableTo.n2]@_@tag@) :named non_empty_is_non_circle_@tag@_@r[NonCircleReachableTo.n1]@_@r[NonCircleReachableTo.n2]@))
</code>

<code AliasDefinition pars=(tag : ID, rels : LIST(CODE.Alias|CODE.NotAlias, "\n"))>
@(res = NULL;
foreach n = CODE.Alias \in rels do
  res = (CODE.AliasAssert#(tag,n)) :: res;
enddo
foreach n = CODE.NotAlias \in rels do
  res = (CODE.NotAliasAssert#(tag,n)) :: res;
enddo
res)@
</code>

<code AliasAssert pars=(tag:ID, r : CODE.Alias) p=NULL>
@CODE.Alias#(v1,v2) = r; 
if (v1 == "null")  v1 = 0;
else v1 = v1 ^ "_" ^ tag;
if (v2 == "null")  v2 = 0;
else v2 = v2 ^ "_" ^ tag;
@(assert (! (= @v1@ @v2@) :named alias_@v1@_@v2@))
</code>

<code NotAliasAssert pars=(tag:ID, r : CODE.NotAlias) p=NULL>
@CODE.NotAlias#(v1,v2) = r; 
if (v1 == "null")  v1 = 0;
else v1 = v1 ^ "_" ^ tag;
if (v2 == "null")  v2 = 0;
else v2 = v2 ^ "_" ^ tag;
@(assert (! (not (= @v1@ @v2@)) :named notalias_@v1@_@v2@))
</code>

<code UnchangedPosition pars=(v : ID, tag1 : ID, tag2 : ID)>
(assert (! (= @v@_@tag1@ @v@_@tag2@) :named unchanged_@v@_@tag1@_@tag2@))
</code>

<code UnchangedVariable pars=(v : ID, tag1 : ID, tag2 : ID)>
(assert (! (= @v@_@tag1@ @v@_@tag2@) :named unchanged_@v@_@tag1@_@tag2@))
</code>

<code HasValueDefinition pars=(tag : ID, rels: LIST(CODE.HasValue,""))>
@(res1 = res2 = NULL;
foreach h = CODE.HasValue \in rels do
  res1 = (CODE.HasValuePossible#(tag, h)) :: res1;
  res2 = (CODE.HasValueAssert#(tag, h)) :: res2;
enddo;
)@(define-fun has_value_@tag@ ((l Int) (r Int)) Bool
    @((res1 : NULL|"")? "false"
   : (cdr(res1) : ""|NULL)? res1
   : ("(or " res1 ")"))@)
@res2@
</code>

<code HasValuePossible pars=(tag, r : CODE.HasValue) >
(and (= l @r[HasValue.n1]@_@tag@)  (= r @r[HasValue.n2]@_@tag@))
</code>

<code HasValueAssert pars=(tag : ID, r : CODE.HasValue)>
(assert (!(=> (has_value_@tag@ @r[HasValue.n1]@_@tag@ @r[HasValue.n2]@_@tag@) (= @r[HasValue.n1]@_@tag@ @r[HasValue.n2]@_@tag@)) :named has_value_@tag@_@r[HasValue.n1]@_@r[HasValue.n2]@))
</code>

<code AliasedPositionSameValueDefinition pars=(pos_variables : LIST(CODE.PositionVariableDefinition,","))>
@(res=NULL;
for(q = pos_variables; q != NULL; q = cdr(q)){
  cur_q = car(q);
  names = cur_q[PositionVariableDefinition.names];
  for(n = names; n != NULL; n = cdr(n)){
    if(car(n) : CODE.HasValue){
      res = CODE.AliasedPositionSameValueAssert#(cur_q[PositionVariableDefinition.tag]) :: res;
      break;
    }
  }
})@
@res@
</code>

<code AliasedPositionSameValueAssert pars=(tag: ID)>
(assert 
  (! (forall ((c1 Int) (c2 Int) (v1 Int) (v2 Int))
       (=> 
         (and (has_value_@tag@ c1 v1) 
              (has_value_@tag@ c2 v2) 
              (= c1 c2))
         (= v1 v2)))
     :named aliased_positions_@tag@_hold_same_value)
)
</code>

<code PositionHasSingleValueDefinition pars=(pos_variables : LIST(CODE.PositionVariableDefinition,","))>
@(res=NULL;
for(q = pos_variables; q != NULL; q = cdr(q)){
  cur_q = car(q);
  names = cur_q[PositionVariableDefinition.names];
  for(n = names; n != NULL; n = cdr(n)){
    if(car(n) : CODE.HasValue){
      res = CODE.PositionHasSingleValueAssert#(cur_q[PositionVariableDefinition.tag]) :: res;
      break;
    }
  }
})@
@res@
</code>

<code PositionHasSingleValueAssert pars=(tag : ID)>
(assert 
  (! (forall ((c Int) (v1 Int) (v2 Int))
       (=> 
         (and (has_value_@tag@ c v1) 
              (has_value_@tag@ c v2))
         (= v1 v2)))
     :named positions_@tag@_have_single_value)
)
</code>
